{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore*", ".*", "**/.*", "**/node_modules/**", "tests/**", "tools/**", "package*.json", "README*"],
    "headers": [{"source":"**/*.js","headers":[{"key":"Cache-Control","value":"no-cache"}]}]
  },
  "emulators": {
    "auth": {"port":9099},
    "firestore": {"port":8080},
    "hosting": {"port":5000},
    "ui": {"enabled":false},
    "singleProjectMode":true
  }
}
